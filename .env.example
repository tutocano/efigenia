# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings -> API en supabase.com)

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo se usa en el servidor (server actions), NUNCA se expone al navegador.
# Necesaria para que el Panel admin pueda crear cuentas (usuario/contraseña)
# para otros miembros de la familia.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
